# ============================================================
# DocMind — Cấu hình môi trường
# Sao chép file này thành .env và điều chỉnh theo môi trường
# ============================================================

# Ollama (mặc định: localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434/v1
MODEL_NAME=gemma4:e4b

# Embedding model (tự động download khi chạy lần đầu, ~90 MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# App
APP_HOST=0.0.0.0
APP_PORT=7860
DEBUG=false

# RAG
DEFAULT_TOP_K=5
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
MAX_TOKENS=2048
TEMPERATURE=0.7
